---
import { getCollection, render } from "astro:content";
import Comments from "@/components/Comments.astro";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  formatDate,
  getAdjacent,
  getRelated,
  postHref,
  postSlug,
  readingLabel,
  visiblePosts,
  type Post,
} from "@/lib/posts";

export async function getStaticPaths() {
  const allPosts = visiblePosts(await getCollection("posts"));

  return allPosts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post, allPosts },
  }));
}

interface Props {
  post: Post;
  allPosts: Post[];
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const { title, excerpt, category, date } = post.data;
const isoDate = date.toISOString();
const readableDate = formatDate(date, "long");
const { older, newer } = getAdjacent(allPosts, post);
const related = getRelated(allPosts, post);
---

<BaseLayout
  title={title}
  description={excerpt}
  type="article"
  prevUrl={older ? postHref(older) : undefined}
  nextUrl={newer ? postHref(newer) : undefined}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <article class="canvas">
      <header class="pagehead">
        <p class="eyebrow">{category}</p>
        <h1 class="pagehead-title">{title}</h1>
        <p class="meta mt-5">
          <time datetime={isoDate}>{readableDate}</time>
          <span>{readingLabel(post)}</span>
        </p>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>

    {
      (older || newer) && (
        <nav
          class="canvas mt-16 flex flex-col gap-6 border-t border-border pt-10 sm:flex-row sm:justify-between"
          aria-label="Navegação entre posts"
        >
          {older ? (
            <a href={postHref(older)} class="link-title max-w-sm">
              <span class="eyebrow">Anterior</span>
              <span class="link-title__text mt-1 block font-semibold">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a href={postHref(newer)} class="link-title max-w-sm sm:text-right">
              <span class="eyebrow">Próximo</span>
              <span class="link-title__text mt-1 block font-semibold">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section class="canvas mt-16" aria-labelledby="related-heading">
          <h2 id="related-heading" class="section-title">
            Continue lendo
          </h2>
          <div class="grid gap-7 sm:grid-cols-3">
            {related.map((relatedPost) => (
              <PostCard post={relatedPost} variant="compact" headingLevel="h3" />
            ))}
          </div>
        </section>
      )
    }

    <div class="canvas mt-16">
      <Comments />
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script src="../../scripts/copy-code.js"></script>
